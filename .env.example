APP_NAME=databy.ai API
APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
DATABASE_URL=sqlite:///./data/databy_ai.db
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SQLITE_UPLOAD_STORAGE_DIR=./data/uploads
MAX_SQLITE_UPLOAD_SIZE_BYTES=52428800
DATABASE_CONNECTION_TIMEOUT_SECONDS=5
POSTGRES_CREDENTIALS_ENCRYPTION_KEY=
POSTGRES_ALLOWED_HOSTS=your-postgres-host.example.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20
SQL_GENERATION_MAX_ATTEMPTS=2
SQL_GENERATION_MAX_QUESTION_CHARS=2000
SQL_GENERATION_MAX_SCHEMA_CHARS=24000
SQL_MAX_QUERY_CHARS=10000
SQL_EXECUTION_TIMEOUT_SECONDS=5
SQL_EXECUTION_DEFAULT_PAGE_SIZE=100
SQL_EXECUTION_MAX_PAGE_SIZE=500
SQL_EXECUTION_MAX_OFFSET=100000
SQL_EXECUTION_MAX_COLUMNS=100
SQL_EXECUTION_MAX_RESULT_BYTES=2097152
SQL_EXECUTION_MAX_CONCURRENT_PER_USER=2
SQL_EXECUTION_RESULT_CACHE_TTL_SECONDS=900
SQL_EXECUTION_RESULT_CACHE_MAX_BYTES=33554432
SQL_EXECUTION_RESULT_CACHE_MAX_ENTRIES=500
